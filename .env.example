# Copia este archivo como .env y ajusta los valores
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
# IP pública / DNS de la instancia EC2, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_PUBLICA
# Orígenes confiables para CSRF (con esquema), separados por coma
DJANGO_CSRF_TRUSTED_ORIGINS=http://TU_IP_PUBLICA

DB_NAME=dulce_arte
DB_USER=dulce_user
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432
