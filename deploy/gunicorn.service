[Unit]
Description=Gunicorn - Dulce Arte
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/dulce_arte
EnvironmentFile=/home/ubuntu/dulce_arte/.env
ExecStart=/home/ubuntu/dulce_arte/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/dulce_arte.sock
Restart=always

[Install]
WantedBy=multi-user.target
